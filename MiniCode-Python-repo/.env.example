# =============================================================================
# MiniCode Python — Environment Variables
# =============================================================================
# Docker Compose: copy this file to .env and fill in your values.
# Native Python runs do not auto-load .env; use shell variables or
# ~/.mini-code/settings.json instead.
# =============================================================================

# --- Active provider/model ---
MINI_CODE_PROVIDER=deepseek
MINI_CODE_MODEL=deepseek-v4-pro

# --- DeepSeek direct API (recommended default) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: enabled or disabled. DeepSeek defaults to enabled.
# DEEPSEEK_THINKING_MODE=enabled
# Optional: low, high, or max.
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-flash

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com

# --- OpenRouter (access to many routed models) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# --- Custom OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM, etc.) ---
# CUSTOM_API_KEY=...
# CUSTOM_API_BASE_URL=http://localhost:11434/v1

# --- Tool catalog ---
# Built-in tool catalog: full (default) or core. Schemas load on demand.
# MINI_CODE_TOOL_PROFILE=core

# --- Web search (separate from the language-model API) ---
# The Web UI also supports Settings > Web search, persisted in local settings.json.
# Nonempty process environment variables take precedence and appear read-only in the UI.
# auto: use configured search APIs first, then public RSS/HTML fallback.
# No search key is required for the public fallback; availability/quality vary.
# Explicit brave/tavily mode requires the corresponding key. Keys stay on the server.
# Native Python runs read shell variables; .env is used by Docker Compose only.
# MINI_CODE_SEARCH_PROVIDER=auto
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# auto uses the OS/HTTP(S)_PROXY settings; direct disables proxy use.
# HTTP CONNECT proxies are supported; target DNS/IP and TLS remain validated.
# MINI_CODE_WEB_PROXY=auto
# MINI_CODE_WEB_PROXY=http://127.0.0.1:7890
# In Docker, use an address reachable from the container, e.g. host.docker.internal.

# --- Logging ---
MINI_CODE_LOG_LEVEL=WARNING
# Options: DEBUG, INFO, WARNING, ERROR

# --- Command output encoding ---
# Encoding used to decode run_command output. Defaults to utf-8.
# On Chinese Windows, set to cp936 (or gbk) so legacy commands that output in
# the OEM code page (dir, systeminfo, batch scripts printing CJK) decode
# correctly instead of mojibake. Pick whichever matches the majority of your
# commands; a single value can't cover mixed utf-8 + cp936 output perfectly.
# MINI_CODE_COMMAND_ENCODING=cp936

# --- Native file search ---
# grep_files requires ripgrep (rg) on PATH. The Docker image includes it.
# Optional executable path override, interpreted inside the running environment.
# Native Python runs must set this in the shell; they do not auto-load .env.
# MINI_CODE_RIPGREP_PATH=/usr/bin/rg

# --- Workspace (for Docker) ---
MINI_CODE_WORKSPACE=.

# --- Optional OpenRouter request metadata ---
# OPENROUTER_REFERER=https://github.com/minicode-py
# OPENROUTER_TITLE=MiniCode Python
# OPENROUTER_TRANSFORMS=

# --- Optional custom endpoint headers ---
# CUSTOM_API_EXTRA_HEADERS=X-Custom-Header:value

# --- User Profile ---
# Set response language and verbosity (also configurable via USER.md)
# MINI_CODE_LANGUAGE=zh-CN
# MINI_CODE_VERBOSITY=normal
# Options for VERBOSITY: concise, normal, detailed
# Create ~/.mini-code/USER.md for full profile customization

# --- Local SQLite authority + file artifacts; no Docker middleware required ---
MEMORY_V2_ENABLED=true
# Optional model-authored working notes; enable only for a task pilot.
MEMORY_HANDOFF_NOTES_ENABLED=false
# Empty: 2048 normally, 4096 for Primary + Ultra. Explicit range: 256-4096.
MEMORY_HANDOFF_NOTE_TOKEN_BUDGET=
# Explicit context rotation requires handoff notes; applies to new task Workers.
MEMORY_CONTEXT_ROTATION_ENABLED=false
MEMORY_SHADOW_WRITE=false
MEMORY_MODE_AUTO=true
MEMORY_MODE_DEFAULT=INLINE
# MEMORY_MODE_OVERRIDE=PAGED_MEMORY

# Supplemental retrieval shares this deadline across FTS, reranking and verification.
MEMORY_CONTEXT_RETRIEVAL_TIMEOUT_SECONDS=12
MEMORY_POST_RERANK_REFILL=true
MEMORY_SOURCE_NEIGHBOR_LIMIT=8
# adaptive skips only unambiguous literal navigation; always scores all eligible requests.
MEMORY_RERANK_POLICY=adaptive
MEMORY_RERANK_SHARED_COORDINATION=true

# Local authority (default, no external service)
MEMORY_BACKEND=sqlite
MINI_CODE_DATA_ROOT=D:/MiniCodeData
MINI_CODE_HISTORY_BACKEND=sqlite
# Native processes derive database/state.db, artifacts, exports, backups and spool.
# MEMORY_SQLITE_PATH=D:/MiniCodeData/database/state.db
# MEMORY_EXPORT_ROOT=D:/MiniCodeData/exports
MEMORY_TENANT_ID=local
# MEMORY_WORKSPACE_ID=
MEMORY_USER_ID=local

# Artifact persistence uses local files.
ARTIFACT_STORE_TYPE=file
# ARTIFACT_STORE_ROOT=D:/MiniCodeData/artifacts

# Encrypted, bounded artifact outage spool. Generate a key with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MEMORY_LOCAL_SPOOL_ENABLED=true
# MEMORY_LOCAL_SPOOL_ROOT=~/.mini-code/memory-v2/spool
# MEMORY_LOCAL_SPOOL_KEY=
MEMORY_LOCAL_SPOOL_MAX_BYTES=268435456
MEMORY_LOCAL_SPOOL_MIN_FREE_BYTES=67108864

# Mode/budget thresholds
MEMORY_WORKING_SET_CONTEXT_RATIO=0.30
MEMORY_PAGED_CONTEXT_RATIO=0.60
MEMORY_WORKING_SET_STEP_THRESHOLD=12
MEMORY_PAGED_STEP_THRESHOLD=40
MEMORY_ARTIFACT_LARGE_BYTES=16000
MEMORY_OUTPUT_TOKEN_RESERVE=4096
MEMORY_TOOL_TOKEN_RESERVE=2048
MEMORY_SAFETY_TOKEN_RESERVE=1024

# Retention, GC, and local encrypted backup
MEMORY_RETENTION_DEFAULT_DAYS=365
# One archive segment is bounded and fails closed instead of silently truncating.
MEMORY_ARCHIVE_MAX_EVENTS=100000
MEMORY_ARCHIVE_MAX_UNCOMPRESSED_BYTES=1073741824
# Ordered rules; supports tenant_ids, memory_types, event_types, artifact_types,
# sensitivity_levels, task_statuses, retention_seconds, archive_after_seconds,
# legal_hold, deletion_mode, and backup_class.
# MEMORY_RETENTION_RULES_JSON=[]
MEMORY_ARTIFACT_GC_GRACE_HOURS=24
# MEMORY_BACKUP_ROOT=D:/MiniCodeData/backups
# MEMORY_BACKUP_ENCRYPTION_KEY=
MEMORY_BACKUP_RPO_HOURS=24
MEMORY_BACKUP_RTO_HOURS=4

# Maximum wait for the first text/reasoning/tool delta during streaming.
# Keep-alive frames do not extend this wait. Ordinary read timeout still applies.
MINICODE_MODEL_FIRST_OUTPUT_TIMEOUT=120
