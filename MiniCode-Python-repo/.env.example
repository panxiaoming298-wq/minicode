# =============================================================================
# MiniCode Python — Environment Variables
# =============================================================================
# Docker Compose: copy this file to .env and fill in your values.
# Native Python runs do not auto-load .env; use shell variables or
# ~/.mini-code/settings.json instead.
# =============================================================================

# --- Active provider/model ---
MINI_CODE_PROVIDER=deepseek
MINI_CODE_MODEL=deepseek-v4-pro

# --- DeepSeek direct API (recommended default) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: enabled or disabled. DeepSeek defaults to enabled.
# DEEPSEEK_THINKING_MODE=enabled
# Optional: low, high, or max.
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-flash

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com

# --- OpenRouter (access to many routed models) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# --- Custom OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM, etc.) ---
# CUSTOM_API_KEY=...
# CUSTOM_API_BASE_URL=http://localhost:11434/v1

# --- Logging ---
MINI_CODE_LOG_LEVEL=WARNING
# Options: DEBUG, INFO, WARNING, ERROR

# --- Command output encoding ---
# Encoding used to decode run_command output. Defaults to utf-8.
# On Chinese Windows, set to cp936 (or gbk) so legacy commands that output in
# the OEM code page (dir, systeminfo, batch scripts printing CJK) decode
# correctly instead of mojibake. Pick whichever matches the majority of your
# commands; a single value can't cover mixed utf-8 + cp936 output perfectly.
# MINI_CODE_COMMAND_ENCODING=cp936

# --- Workspace (for Docker) ---
MINI_CODE_WORKSPACE=.

# --- Optional OpenRouter request metadata ---
# OPENROUTER_REFERER=https://github.com/minicode-py
# OPENROUTER_TITLE=MiniCode Python
# OPENROUTER_TRANSFORMS=

# --- Optional custom endpoint headers ---
# CUSTOM_API_EXTRA_HEADERS=X-Custom-Header:value

# --- User Profile ---
# Set response language and verbosity (also configurable via USER.md)
# MINI_CODE_LANGUAGE=zh-CN
# MINI_CODE_VERBOSITY=normal
# Options for VERBOSITY: concise, normal, detailed
# Create ~/.mini-code/USER.md for full profile customization

# --- Tiered context + lossless out-of-window memory (opt-in) ---
# Safe rollout: first enable shadow writes, verify, then enable context control.
MEMORY_V2_ENABLED=false
MEMORY_SHADOW_WRITE=false
MEMORY_MODE_AUTO=true
MEMORY_MODE_DEFAULT=INLINE
# MEMORY_MODE_OVERRIDE=PAGED_MEMORY

# Local authority (default, no external service)
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=~/.mini-code/memory-v2/state.db
MEMORY_TENANT_ID=local
# MEMORY_WORKSPACE_ID=
MEMORY_USER_ID=local

# Optional Docker profile authority. Do not use the development password in production.
MEMORY_BIND_HOST=127.0.0.1
# MEMORY_BACKEND=postgres
# MEMORY_DATABASE_URL=postgresql://minicode:minicode-dev-only@memory-postgres:5432/minicode
# MEMORY_POSTGRES_DB=minicode
# MEMORY_POSTGRES_USER=minicode
# MEMORY_POSTGRES_PASSWORD=minicode-dev-only

# Artifact persistence. "file" is the default; "minio" uses the memory profile.
ARTIFACT_STORE_TYPE=file
ARTIFACT_STORE_ROOT=~/.mini-code/memory-v2/artifacts
# ARTIFACT_STORE_TYPE=minio
# ARTIFACT_STORE_ENDPOINT=http://memory-minio:9000
# ARTIFACT_STORE_BUCKET=minicode-artifacts
# ARTIFACT_STORE_ACCESS_KEY=minioadmin
# ARTIFACT_STORE_SECRET_KEY=minioadmin
# MEMORY_MINIO_ACCESS_KEY=minioadmin
# MEMORY_MINIO_SECRET_KEY=minioadmin

# Encrypted, bounded artifact outage spool. Generate a key with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MEMORY_LOCAL_SPOOL_ENABLED=true
# MEMORY_LOCAL_SPOOL_ROOT=~/.mini-code/memory-v2/spool
# MEMORY_LOCAL_SPOOL_KEY=
MEMORY_LOCAL_SPOOL_MAX_BYTES=268435456
MEMORY_LOCAL_SPOOL_MIN_FREE_BYTES=67108864

# Milvus is a rebuildable supplemental index, never the fact source.
MEMORY_INDEXER_ENABLED=true
MEMORY_INDEXER_ASYNC=true
MEMORY_INDEXER_MAX_RETRIES=8
MEMORY_INDEXER_RETRY_BACKOFF_SECONDS=5
# Long-lived Docker consumer settings
MEMORY_INDEXER_BATCH_SIZE=100
MEMORY_INDEXER_POLL_SECONDS=1.0
MILVUS_ENABLED=false
# MILVUS_URI=http://memory-milvus:19530
# MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=agent_memory_v2
MILVUS_DENSE_DIM=512
MILVUS_METRIC_TYPE=COSINE
MILVUS_CONSISTENCY_LEVEL=Strong
MILVUS_INDEX_TYPE=AUTOINDEX
# Local semantic embeddings; the model cache lives in the persistent
# minicode-home volume in Docker. Hash embeddings are test-only.
MEMORY_EMBEDDING_PROVIDER=fastembed
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_EMBEDDING_REVISION=fastembed-0.8.0-builtin-v1
# MEMORY_EMBEDDING_CACHE_DIR=~/.mini-code/models/fastembed
MEMORY_EMBEDDING_THREADS=0
MEMORY_EMBEDDING_BATCH_SIZE=64
MEMORY_EMBEDDING_ALLOW_HASH=false

# Mode/budget thresholds
MEMORY_WORKING_SET_CONTEXT_RATIO=0.30
MEMORY_PAGED_CONTEXT_RATIO=0.60
MEMORY_WORKING_SET_STEP_THRESHOLD=12
MEMORY_PAGED_STEP_THRESHOLD=40
MEMORY_ARTIFACT_LARGE_BYTES=16000
MEMORY_OUTPUT_TOKEN_RESERVE=4096
MEMORY_TOOL_TOKEN_RESERVE=2048
MEMORY_SAFETY_TOKEN_RESERVE=1024

# Retention, GC, and local encrypted backup
MEMORY_RETENTION_DEFAULT_DAYS=365
# One archive segment is bounded and fails closed instead of silently truncating.
MEMORY_ARCHIVE_MAX_EVENTS=100000
MEMORY_ARCHIVE_MAX_UNCOMPRESSED_BYTES=1073741824
# Ordered rules; supports tenant_ids, memory_types, event_types, artifact_types,
# sensitivity_levels, task_statuses, retention_seconds, archive_after_seconds,
# legal_hold, deletion_mode, and backup_class.
# MEMORY_RETENTION_RULES_JSON=[]
MEMORY_ARTIFACT_GC_GRACE_HOURS=24
MEMORY_BACKUP_ROOT=~/.mini-code/memory-v2/backups
# MEMORY_BACKUP_ENCRYPTION_KEY=
MEMORY_BACKUP_RPO_HOURS=24
MEMORY_BACKUP_RTO_HOURS=4
